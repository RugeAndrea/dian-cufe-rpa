# Copy this file to .env and adjust as needed. All values are optional;
# defaults live in src/rpa/config.py.

# DIAN_BASE_URL=https://catalogo-vpfe.dian.gov.co
# DIAN_SEARCH_PATH=/User/SearchDocument
# DIAN_DETAIL_URL_PATTERN=**/Document/ShowDocumentToPublic**
# DIAN_DOWNLOAD_ENDPOINT=/Document/DownloadPDF

# CHROME_CHANNEL=chrome
# HEADLESS=false

# CAPTCHA_TIMEOUT_S=30
# NAV_TIMEOUT_MS=30000
# SEARCH_RESULT_TIMEOUT_MS=20000
# DOWNLOAD_BOOTBOX_TIMEOUT_MS=10000
# DOWNLOAD_TIMEOUT_MS=25000

# MAX_ATTEMPTS=3
# BACKOFF_BASE_S=2
# PAUSE_MIN_S=2
# PAUSE_MAX_S=4

# INPUT_CSV=data/input.csv
# OUTPUT_DIR=output

# Seconds before the entrypoint's `timeout` kills a hung run (see entrypoint.sh)
# RPA_TIMEOUT=600
